{
  "version": "v1",
  "hooks": [
    {
      "name": "Verify GhostBBS tests after code edits",
      "trigger": "PostFileSave",
      "matcher": "(^|/)(src/.*\\.js|tests/.*\\.mjs|index\\.html)$",
      "action": {
        "type": "command",
        "command": "node --test tests/*.test.mjs"
      }
    }
  ]
}
